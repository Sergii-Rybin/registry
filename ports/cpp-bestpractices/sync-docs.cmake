# Pure CMake script for syncing verified C++ code snippets and executable outputs
# into Markdown documentation files.
#
# Supported markers in Markdown:
#   <!-- snippet: relative/path.cpp --> ... <!-- end-snippet -->
#   <!-- snippet: relative/path.cpp#region --> ... <!-- end-snippet -->
#   <!-- output: target_name [args...] --> ... <!-- end-output -->
#
# Source markers:
#   // [snippet:region] ... // [end:region]   (extract named region)
#   <code line> // [hide]                     (omit single line from snippet)
#   // [hide] ... // [end-hide]               (omit block of lines from snippet)

cmake_minimum_required(VERSION 4.5)

set(_BSLASH "__CMAKE_SYNC_DOCS_BACKSLASH__")
set(_SEMI   "__CMAKE_SYNC_DOCS_SEMICOLON__")
if(NOT DEFINED EXEC_TIMEOUT)
    set(EXEC_TIMEOUT 15)
endif()

# Losslessly split text into a CMake list of lines (preserving `\` and `;`)
function(_split_lines text out_lines out_had_nl)
    string(REPLACE "\r\n" "\n" norm "${text}")
    string(REPLACE "\\" "${_BSLASH}" safe "${norm}")
    string(REPLACE ";" "${_SEMI}" safe "${safe}")
    string(REPLACE "\n" ";" lines "${safe}")

    set(had_nl FALSE)
    list(LENGTH lines len)
    if(len GREATER 0)
        list(GET lines -1 tail)
        if(tail STREQUAL "")
            set(had_nl TRUE)
            list(REMOVE_AT lines -1)
        endif()
    endif()

    set(${out_lines} "${lines}")
    set(${out_had_nl} "${had_nl}")
    return(PROPAGATE ${out_lines} ${out_had_nl})
endfunction()

function(_unescape text out_var)
    string(REPLACE "${_SEMI}" ";" decoded "${text}")
    string(REPLACE "${_BSLASH}" "\\" decoded "${decoded}")
    set(${out_var} "${decoded}")
    return(PROPAGATE ${out_var})
endfunction()

function(_detect_lang filepath out_var)
    cmake_path(GET filepath EXTENSION LAST_ONLY ext)
    string(TOLOWER "${ext}" ext)
    if(ext MATCHES "^\\.(cpp|cc|cxx|hpp|hh|hxx|h|cppm|ixx)$")
        set(${out_var} "cpp")
    elseif(ext STREQUAL ".cmake")
        set(${out_var} "cmake")
    elseif(ext STREQUAL ".json")
        set(${out_var} "json")
    elseif(ext STREQUAL ".sh")
        set(${out_var} "bash")
    elseif(ext MATCHES "^\\.(yml|yaml)$")
        set(${out_var} "yaml")
    else()
        set(${out_var} "text")
    endif()
    return(PROPAGATE ${out_var})
endfunction()

function(_extract_snippet spec out_code out_lang)
    if(spec MATCHES "^([^#]+)#(.+)$")
        set(rel_path "${CMAKE_MATCH_1}")
        set(region "${CMAKE_MATCH_2}")
    else()
        set(rel_path "${spec}")
        set(region "")
    endif()

    set(abs_path "${SOURCE_DIR}/${rel_path}")
    if(NOT EXISTS "${abs_path}")
        message(FATAL_ERROR "sync-docs: snippet source not found: ${abs_path}")
    endif()

    _detect_lang("${abs_path}" ${out_lang})
    file(READ "${abs_path}" raw)
    _split_lines("${raw}" lines _unused_nl)

    # Extract named region (or whole file)
    set(raw_extracted "")
    if(region STREQUAL "")
        set(raw_extracted "${lines}")
    else()
        set(capturing FALSE)
        set(found FALSE)
        foreach(line IN LISTS lines)
            if(NOT capturing)
                if(line MATCHES "^[ \t]*//[ \t]*\\[snippet:${region}\\][ \t]*$")
                    set(capturing TRUE)
                    set(found TRUE)
                endif()
            else()
                if(line MATCHES "^[ \t]*//[ \t]*\\[end:${region}\\][ \t]*$")
                    set(capturing FALSE)
                    break()
                endif()
                list(APPEND raw_extracted "${line}")
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "sync-docs: region '${region}' not found in ${rel_path}")
        elseif(capturing)
            message(FATAL_ERROR "sync-docs: unclosed region '${region}' in ${rel_path}")
        endif()
    endif()

    # Strip single-line `... // [hide]` and block `// [hide]` ... `// [end-hide]`
    set(extracted "")
    set(hiding FALSE)
    foreach(line IN LISTS raw_extracted)
        if(hiding)
            if(line MATCHES "^[ \t]*//[ \t]*\\[end-hide\\][ \t]*$")
                set(hiding FALSE)
            endif()
            continue()
        elseif(line MATCHES "^[ \t]*//[ \t]*\\[hide\\][ \t]*$")
            set(hiding TRUE)
            continue()
        elseif(line MATCHES "//[ \t]*\\[hide\\][ \t]*$")
            continue()
        endif()
        list(APPEND extracted "${line}")
    endforeach()
    if(hiding)
        message(FATAL_ERROR "sync-docs: unclosed '// [hide]' block in ${rel_path}")
    endif()

    # Compute common leading indentation and join lines
    set(min_indent 9999)
    set(joined "")
    set(first TRUE)
    foreach(line IN LISTS extracted)
        if(NOT line MATCHES "^[ \t]*$")
            string(REGEX MATCH "^[ ]*" leading "${line}")
            string(LENGTH "${leading}" len)
            if(len LESS min_indent)
                set(min_indent ${len})
            endif()
        endif()
        if(NOT first)
            string(APPEND joined "\n")
        endif()
        set(first FALSE)
        string(APPEND joined "${line}")
    endforeach()

    if(min_indent GREATER 0 AND min_indent LESS 9999)
        string(REPEAT " " ${min_indent} pad)
        string(REGEX REPLACE "(^|\n)${pad}" "\\1" joined "${joined}")
    endif()

    set(${out_code} "${joined}")
    return(PROPAGATE ${out_code} ${out_lang})
endfunction()

function(_run_output_target spec out_text)
    separate_arguments(cmd_parts UNIX_COMMAND "${spec}")
    list(POP_FRONT cmd_parts target_name)

    set(exe_path "")
    foreach(entry IN LISTS TARGET_MAP)
        if(entry MATCHES "^([^=]+)=(.+)$" AND CMAKE_MATCH_1 STREQUAL target_name)
            set(exe_path "${CMAKE_MATCH_2}")
            break()
        endif()
    endforeach()

    if(exe_path STREQUAL "")
        message(FATAL_ERROR "sync-docs: target '${target_name}' not listed in TARGETS")
    elseif(NOT EXISTS "${exe_path}")
        message(FATAL_ERROR "sync-docs: executable not found for '${target_name}': ${exe_path}")
    endif()

    set(cmd "")
    if(DEFINED EMULATOR AND NOT EMULATOR STREQUAL "")
        separate_arguments(emu_parts UNIX_COMMAND "${EMULATOR}")
        list(APPEND cmd ${emu_parts})
    endif()
    list(APPEND cmd "${exe_path}" ${cmd_parts})

    execute_process(
        COMMAND ${cmd}
        TIMEOUT ${EXEC_TIMEOUT}
        OUTPUT_VARIABLE stdout_val
        ERROR_VARIABLE stderr_val
        RESULT_VARIABLE exit_code
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT exit_code EQUAL 0)
        message(FATAL_ERROR "sync-docs: '${spec}' failed (${exit_code}):\n${stderr_val}")
    endif()

    string(REPLACE "\r\n" "\n" stdout_val "${stdout_val}")
    string(REPLACE "\\" "${_BSLASH}" stdout_val "${stdout_val}")
    string(REPLACE ";" "${_SEMI}" stdout_val "${stdout_val}")
    set(${out_text} "${stdout_val}")
    return(PROPAGATE ${out_text})
endfunction()

set(out_of_sync FALSE)

foreach(rel_doc IN LISTS FILES)
    block(PROPAGATE out_of_sync)
        set(abs_doc "${SOURCE_DIR}/${rel_doc}")
        if(NOT EXISTS "${abs_doc}")
            message(FATAL_ERROR "sync-docs: documentation file not found: ${abs_doc}")
        endif()

        file(READ "${abs_doc}" orig_content)
        string(REPLACE "\r\n" "\n" orig_content "${orig_content}")
        _split_lines("${orig_content}" doc_lines had_trailing_nl)

        set(new_content "")
        set(skip_until "")
        set(first_line TRUE)

        foreach(line IN LISTS doc_lines)
            if(NOT skip_until STREQUAL "")
                if(line MATCHES "^[ \t]*<!-- ${skip_until} -->[ \t]*$")
                    string(APPEND new_content "\n${line}")
                    set(skip_until "")
                endif()
                continue()
            endif()

            if(NOT first_line)
                string(APPEND new_content "\n")
            endif()
            set(first_line FALSE)

            if(line MATCHES "^[ \t]*<!-- snippet:[ \t]*([^ \t].*[^ \t]|[^ \t])[ \t]*-->[ \t]*$")
                _extract_snippet("${CMAKE_MATCH_1}" code_safe code_lang)
                string(APPEND new_content "${line}\n```${code_lang}\n${code_safe}\n```")
                set(skip_until "end-snippet")
            elseif(line MATCHES "^[ \t]*<!-- output:[ \t]*([^ \t].*[^ \t]|[^ \t])[ \t]*-->[ \t]*$")
                _run_output_target("${CMAKE_MATCH_1}" captured_safe)
                string(APPEND new_content "${line}\n```text\n${captured_safe}\n```")
                set(skip_until "end-output")
            else()
                string(APPEND new_content "${line}")
            endif()
        endforeach()

        if(NOT skip_until STREQUAL "")
            message(FATAL_ERROR "sync-docs: missing closing '<!-- ${skip_until} -->' in ${rel_doc}")
        endif()

        if(had_trailing_nl)
            string(APPEND new_content "\n")
        endif()

        _unescape("${new_content}" new_content)

        if(NOT new_content STREQUAL orig_content)
            if(CHECK_ONLY)
                message(WARNING "sync-docs: ${rel_doc} is out of sync")
                set(out_of_sync TRUE)
            else()
                file(WRITE "${abs_doc}" "${new_content}")
                message(STATUS "sync-docs: updated ${rel_doc}")
            endif()
        else()
            message(STATUS "sync-docs: ${rel_doc} is up to date")
        endif()
    endblock()
endforeach()

if(out_of_sync)
    message(FATAL_ERROR "sync-docs: documentation is out of sync. Run the 'docs-sync' build target.")
endif()
